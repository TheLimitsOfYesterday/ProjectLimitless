<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Project Limitless" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'application' %>
  </head>

  <body>
    <header class="relative flex items-center justify-between px-6 py-4 md:px-10">
      <%= link_to root_path, class: "font-display text-lg tracking-tight text-mist hover:text-signal transition-colors" do %>
        Limitless
      <% end %>

      <span class="absolute left-1/2 -translate-x-1/2 font-display text-sm uppercase tracking-[0.2em] text-mist-muted">
        Benjamin Lambert
      </span>

      <nav class="flex gap-6 text-sm text-mist-muted">
        <%= link_to "About", about_path, class: "hover:text-signal transition-colors" %>
        <%= link_to "Projects", projects_path, class: "hover:text-signal transition-colors" %>
        <%= link_to "Resume", resume_path, class: "hover:text-signal transition-colors" %>
      </nav>
    </header>
    
    <main class="px-6 md:px-10">
      <%= yield %>
    </main>

    <footer class="mt-24 flex-col items-center gap-2 px-6 py-10 text-center text-sm text-mist-muted md:px-10">
      <div class="flex gap-4">
        <a href="mailto:b3nlamb3r7@gmail.com" class="hover:text-signal transition-colors">b3nlamb3r7@gmail.com</a>
        <a href="https://github.com/TheLimitsOfYesterday" class="hover:text-signal transition-colors">GitHub</a>
      </div>
      <p>Ben Lambert</p>
    </footer>

    <%= vite_javascript_tag 'application' %>
  </body>
</html>
